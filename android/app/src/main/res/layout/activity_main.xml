<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F13"
    tools:context=".MainActivity">

    <!-- ── App title ────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:text="Vexora AI  •  Offline"
        android:textColor="#E0E0FF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ══════════════════════════════════════════════════════════════════
         SCREEN 1: AUTO-DOWNLOAD / LOADING PROGRESS
    ═══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutDownload"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        tools:visibility="visible">

        <!-- Spinning robot icon area -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="24dp"
            android:src="@android:drawable/stat_sys_download"
            android:tint="#4B4BFF"
            android:contentDescription="Downloading" />

        <TextView
            android:id="@+id/tvDownloadLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Downloading AI model…"
            android:textColor="#E0E0FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Progress bar — indeterminate while connecting, fills during download -->
        <ProgressBar
            android:id="@+id/downloadProgress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:indeterminate="true"
            android:max="100"
            android:progressTint="#4B4BFF"
            android:indeterminateTint="#4B4BFF" />

        <TextView
            android:id="@+id/tvDownloadSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text=""
            android:textColor="#888899"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="This only happens once.\nAfter this the app works 100% offline."
            android:textColor="#555577"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════════
         SCREEN 2: FALLBACK — shown only if auto-download fails
    ═══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutFallback"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp"
            android:src="@android:drawable/ic_dialog_alert"
            android:tint="#FF6B6B"
            android:contentDescription="Error" />

        <TextView
            android:id="@+id/tvFallbackMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:textColor="#C0C0E0"
            android:textSize="14sp"
            tools:text="Auto-download failed. Please pick your model file manually." />

        <Button
            android:id="@+id/btnPickModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#4B4BFF"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="Choose Model File (.bin)"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════════
         SCREEN 3: CHAT — shown once model is loaded
    ═══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        tools:visibility="visible">

        <!-- "Thinking…" label -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            android:text="Thinking…"
            android:textColor="#7C7CFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Response area -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="#1A1A24"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:hint="Responses will appear here…"
                android:lineSpacingMultiplier="1.4"
                android:textColor="#D0D0E8"
                android:textColorHint="#444466"
                android:textSize="15sp"
                tools:text="AI: Hello! How can I help?" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="#2A2A3A" />

        <!-- Input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#1E1E2E"
                android:hint="Ask me anything…"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minLines="1"
                android:padding="12dp"
                android:textColor="#E0E0FF"
                android:textColorHint="#44446A"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#4B4BFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Send"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
