<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F13"
    tools:context=".MainActivity">

    <!-- ── Title ────────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:text="Vexora AI  •  Offline"
        android:textColor="#E0E0FF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ══════════════════════════════════════════════════════════════════════
         SETUP SCREEN  — shown when no model is present
    ══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutSetup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        tools:visibility="visible">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="20dp"
            android:src="@android:drawable/ic_menu_upload"
            android:tint="#4B4BFF"
            android:contentDescription="Upload model" />

        <TextView
            android:id="@+id/tvSetupInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.5"
            android:textColor="#C0C0E0"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            tools:text="Instructions appear here" />

        <Button
            android:id="@+id/btnPickModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Model File (.bin)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B4BFF"
            android:paddingStart="28dp"
            android:paddingEnd="28dp" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════════════
         CHAT SCREEN  — shown once model is loaded
    ══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        tools:visibility="visible">

        <!-- Status label (Thinking… / Loading…) -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            android:text="Loading AI model… please wait"
            android:textColor="#7C7CFF"
            android:textSize="13sp"
            android:visibility="visible" />

        <!-- Scrollable response area -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="#1A1A24"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.4"
                android:textColor="#D0D0E8"
                android:textSize="15sp"
                android:fontFamily="monospace"
                android:hint="Responses will appear here…"
                android:textColorHint="#444466"
                tools:text="AI: Hello! How can I help you?" />
        </ScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="#2A2A3A" />

        <!-- Input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="#1E1E2E"
                android:hint="Ask me anything…"
                android:textColor="#E0E0FF"
                android:textColorHint="#44446A"
                android:textSize="15sp"
                android:padding="12dp"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minLines="1" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4B4BFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
