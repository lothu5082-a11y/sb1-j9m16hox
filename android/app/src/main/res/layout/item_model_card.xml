<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/model_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top row: name + active badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvProviderName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E0E0FF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvActiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_active_bg"
            android:paddingBottom="3dp"
            android:paddingEnd="8dp"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:text="● ACTIVE"
            android:textColor="#7B7BFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvProviderDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#6666AA"
        android:textSize="12sp"/>

    <!-- API key input section -->
    <LinearLayout
        android:id="@+id/keySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:hint="Paste API key here"
            android:inputType="textVisiblePassword"
            android:paddingBottom="10dp"
            android:paddingEnd="14dp"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:textColor="#E0E0FF"
            android:textColorHint="#44446A"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/btnSaveKey"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/circle_send"
            android:text="Save &amp; Activate"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>

    </LinearLayout>

    <!-- Download section (Gemma only) -->
    <LinearLayout
        android:id="@+id/downloadSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnDownload"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/circle_send"
            android:text="Download Model (~1.5 GB)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>

        <ProgressBar
            android:id="@+id/downloadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#5A5ADF"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvDownloadProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0%"
            android:textColor="#5A5ADF"
            android:textSize="12sp"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
